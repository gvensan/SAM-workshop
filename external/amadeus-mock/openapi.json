{
  "openapi": "3.0.3",
  "info": {
    "title": "Amadeus Travel API Mock",
    "description": "Mock implementation of Amadeus Self-Service APIs for flights and hotels. Default credentials: client_id=test / client_secret=test.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8090",
      "description": "Local Docker instance"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/security/oauth2/token": {
      "post": {
        "operationId": "getAccessToken",
        "summary": "Get OAuth2 access token",
        "description": "Exchange client credentials for a Bearer token. Use client_id=test and client_secret=test for the mock service.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["client_id", "client_secret", "grant_type"],
                "properties": {
                  "client_id": {
                    "type": "string",
                    "description": "Application client ID",
                    "example": "test"
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "Application client secret",
                    "example": "test"
                  },
                  "grant_type": {
                    "type": "string",
                    "enum": ["client_credentials"],
                    "description": "Must be client_credentials"
                  }
                }
              },
              "example": {
                "client_id": "test",
                "client_secret": "test",
                "grant_type": "client_credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid grant type"
          },
          "401": {
            "description": "Invalid client credentials"
          }
        }
      }
    },
    "/v2/shopping/flight-offers": {
      "get": {
        "operationId": "searchFlightOffers",
        "summary": "Search for available flights",
        "description": "Search flights by origin, destination and date. Supported routes: SIN-LHR, SIN-SYD, SIN-HND, SIN-BKK, JFK-LAX, LHR-CDG, DXB-SIN, HKG-LHR.",
        "parameters": [
          {
            "name": "originLocationCode",
            "in": "query",
            "required": true,
            "description": "Origin airport IATA code (e.g. SIN, JFK, LHR)",
            "schema": {
              "type": "string"
            },
            "example": "SIN"
          },
          {
            "name": "destinationLocationCode",
            "in": "query",
            "required": true,
            "description": "Destination airport IATA code (e.g. LHR, SYD, LAX)",
            "schema": {
              "type": "string"
            },
            "example": "LHR"
          },
          {
            "name": "departureDate",
            "in": "query",
            "required": true,
            "description": "Departure date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-01"
          },
          {
            "name": "adults",
            "in": "query",
            "required": true,
            "description": "Number of adult travelers (1-9)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "example": 1
          },
          {
            "name": "returnDate",
            "in": "query",
            "required": false,
            "description": "Return date for round-trip in YYYY-MM-DD format. Omit for one-way.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-15"
          },
          {
            "name": "travelClass",
            "in": "query",
            "required": false,
            "description": "Cabin class filter. Omit to return all classes.",
            "schema": {
              "type": "string",
              "enum": ["ECONOMY", "PREMIUM_ECONOMY", "BUSINESS", "FIRST"]
            },
            "example": "ECONOMY"
          },
          {
            "name": "max",
            "in": "query",
            "required": false,
            "description": "Maximum number of offers to return (1-250, default 10)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 10
            }
          },
          {
            "name": "currencyCode",
            "in": "query",
            "required": false,
            "description": "Currency code for prices (default USD)",
            "schema": {
              "type": "string",
              "default": "USD"
            },
            "example": "USD"
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching flight offers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          }
        }
      }
    },
    "/v1/booking/flight-orders": {
      "post": {
        "operationId": "createFlightOrder",
        "summary": "Create a flight booking",
        "description": "Book one or more flight offers returned from /v2/shopping/flight-offers. Returns a flight order with PNR reference.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightOrderRequest"
              },
              "example": {
                "data": {
                  "type": "flight-order",
                  "flightOffers": [
                    {
                      "type": "flight-offer",
                      "id": "1",
                      "source": "GDS",
                      "itineraries": [],
                      "price": {
                        "currency": "USD",
                        "total": "1172.91",
                        "grandTotal": "1172.91"
                      },
                      "travelerPricings": []
                    }
                  ],
                  "travelers": [
                    {
                      "id": "1",
                      "dateOfBirth": "1990-04-14",
                      "name": {
                        "firstName": "JOHN",
                        "lastName": "DOE"
                      },
                      "gender": "MALE",
                      "contact": {
                        "emailAddress": "john.doe@example.com",
                        "phones": [
                          {
                            "deviceType": "MOBILE",
                            "countryCallingCode": "65",
                            "number": "91234567"
                          }
                        ]
                      },
                      "documents": [
                        {
                          "documentType": "PASSPORT",
                          "number": "A12345678",
                          "expiryDate": "2030-01-01",
                          "issuanceCountry": "SG",
                          "nationality": "SG",
                          "holder": true
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Flight order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/booking/flight-orders/{orderId}": {
      "get": {
        "operationId": "getFlightOrder",
        "summary": "Retrieve a flight order",
        "description": "Fetch details of a previously created flight booking by its order ID.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Flight order ID returned from POST /v1/booking/flight-orders",
            "schema": {
              "type": "string"
            },
            "example": "MOCK3F9A1B2C"
          }
        ],
        "responses": {
          "200": {
            "description": "Flight order details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightOrderResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Order not found"
          }
        }
      },
      "delete": {
        "operationId": "cancelFlightOrder",
        "summary": "Cancel a flight order",
        "description": "Cancel and delete a flight booking by its order ID.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Flight order ID to cancel",
            "schema": {
              "type": "string"
            },
            "example": "MOCK3F9A1B2C"
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/v1/reference-data/locations/hotels/by-city": {
      "get": {
        "operationId": "listHotelsByCity",
        "summary": "List hotels in a city",
        "description": "Returns all available hotels for a given city code. Supported cities: SIN, LON/LHR, NYC/JFK, SYD, DXB, PAR/CDG, TYO/HND.",
        "parameters": [
          {
            "name": "cityCode",
            "in": "query",
            "required": true,
            "description": "City or airport IATA code (e.g. SIN, LON, NYC, SYD, DXB, PAR, TYO)",
            "schema": {
              "type": "string"
            },
            "example": "SIN"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Search radius from city center",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300,
              "default": 5
            }
          },
          {
            "name": "radiusUnit",
            "in": "query",
            "required": false,
            "description": "Unit for the radius parameter",
            "schema": {
              "type": "string",
              "enum": ["KM", "MILE"],
              "default": "KM"
            }
          },
          {
            "name": "hotelSource",
            "in": "query",
            "required": false,
            "description": "Filter by hotel source",
            "schema": {
              "type": "string",
              "enum": ["ALL", "BEDBANK", "DIRECTCHAIN"],
              "default": "ALL"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of hotels in the city",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v3/shopping/hotel-offers": {
      "get": {
        "operationId": "searchHotelOffers",
        "summary": "Search room offers for specific hotels",
        "description": "Returns available room types, pricing, and cancellation policies for one or more hotel IDs obtained from /v1/reference-data/locations/hotels/by-city.",
        "parameters": [
          {
            "name": "hotelIds",
            "in": "query",
            "required": true,
            "description": "Comma-separated hotel IDs from the hotel list endpoint (e.g. ADSINFL1,ADSINMA1)",
            "schema": {
              "type": "string"
            },
            "example": "ADSINFL1,ADSINMA1"
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Number of adult guests (1-9)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9,
              "default": 1
            },
            "example": 2
          },
          {
            "name": "checkInDate",
            "in": "query",
            "required": true,
            "description": "Check-in date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-15"
          },
          {
            "name": "checkOutDate",
            "in": "query",
            "required": true,
            "description": "Check-out date in YYYY-MM-DD format. Must be after checkInDate.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-12-18"
          },
          {
            "name": "roomQuantity",
            "in": "query",
            "required": false,
            "description": "Number of rooms required",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9,
              "default": 1
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Currency for prices (default USD)",
            "schema": {
              "type": "string",
              "default": "USD"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room offers for each requested hotel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelOffersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date format or checkOutDate is not after checkInDate"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v3/shopping/hotel-offers/{offerId}": {
      "get": {
        "operationId": "getHotelOffer",
        "summary": "Retrieve a single hotel offer",
        "description": "Fetch details of a specific hotel room offer by its offer ID.",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "description": "Hotel offer ID from /v3/shopping/hotel-offers",
            "schema": {
              "type": "string"
            },
            "example": "OFF3F9A1B2C4D5E"
          }
        ],
        "responses": {
          "200": {
            "description": "Hotel offer details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelOfferDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Offer not found"
          }
        }
      }
    },
    "/v2/booking/hotel-orders": {
      "post": {
        "operationId": "createHotelOrder",
        "summary": "Create a hotel booking",
        "description": "Book a hotel room offer returned from /v3/shopping/hotel-offers. Returns a confirmed booking with confirmation number.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HotelOrderRequest"
              },
              "example": {
                "data": {
                  "hotelOffers": [
                    {
                      "id": "OFF3F9A1B2C4D5E"
                    }
                  ],
                  "guests": [
                    {
                      "tid": 1,
                      "title": "MR",
                      "firstName": "JOHN",
                      "lastName": "DOE",
                      "phone": "+6591234567",
                      "email": "john.doe@example.com"
                    }
                  ],
                  "payments": [
                    {
                      "id": 1,
                      "method": "creditCard",
                      "card": {
                        "vendorCode": "VI",
                        "cardNumber": "4111111111111111",
                        "expiryDate": "2028-01"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hotel order confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/booking/hotel-orders/{orderId}": {
      "get": {
        "operationId": "getHotelOrder",
        "summary": "Retrieve a hotel order",
        "description": "Fetch details of a previously confirmed hotel booking by its order ID.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Hotel order ID returned from POST /v2/booking/hotel-orders",
            "schema": {
              "type": "string"
            },
            "example": "HORDER3F9A1B2C"
          }
        ],
        "responses": {
          "200": {
            "description": "Hotel order details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelOrderResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token obtained from POST /v1/security/oauth2/token"
      }
    },
    "schemas": {
      "TokenResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "amadeusOAuth2Token"
          },
          "username": {
            "type": "string",
            "example": "ws-with-test@amadeus-mock"
          },
          "application_name": {
            "type": "string",
            "example": "AmadeusMock"
          },
          "client_id": {
            "type": "string",
            "example": "test"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "access_token": {
            "type": "string",
            "example": "AaxFD-Ih3Zs45vp_aS27nDdI90D6RF8iJqX9xku0oew"
          },
          "expires_in": {
            "type": "integer",
            "example": 1799
          },
          "state": {
            "type": "string",
            "example": "approved"
          },
          "scope": {
            "type": "string",
            "example": ""
          }
        }
      },
      "FlightSearchResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "example": 3
              },
              "links": {
                "type": "object",
                "properties": {
                  "self": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "data": {
            "type": "array",
            "description": "Array of flight offers",
            "items": {
              "$ref": "#/components/schemas/FlightOffer"
            }
          },
          "dictionaries": {
            "type": "object",
            "properties": {
              "locations": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "cityCode": { "type": "string" },
                    "countryCode": { "type": "string" }
                  }
                }
              },
              "aircraft": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "example": { "359": "AIRBUS A350-900" }
              },
              "currencies": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "carriers": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "example": { "SQ": "SINGAPORE AIRLINES" }
              }
            }
          }
        }
      },
      "FlightOffer": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "flight-offer"
          },
          "id": {
            "type": "string",
            "example": "1"
          },
          "source": {
            "type": "string",
            "example": "GDS"
          },
          "instantTicketingRequired": {
            "type": "boolean",
            "example": false
          },
          "oneWay": {
            "type": "boolean",
            "example": true
          },
          "lastTicketingDate": {
            "type": "string",
            "format": "date",
            "example": "2026-10-12"
          },
          "numberOfBookableSeats": {
            "type": "integer",
            "example": 9
          },
          "itineraries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "duration": {
                  "type": "string",
                  "example": "PT13H30M"
                },
                "segments": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlightSegment"
                  }
                }
              }
            }
          },
          "price": {
            "$ref": "#/components/schemas/FlightPrice"
          },
          "pricingOptions": {
            "type": "object",
            "properties": {
              "fareType": {
                "type": "array",
                "items": { "type": "string" }
              },
              "includedCheckedBagsOnly": {
                "type": "boolean"
              }
            }
          },
          "validatingAirlineCodes": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["SQ"]
          },
          "travelerPricings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TravelerPricing"
            }
          }
        }
      },
      "FlightSegment": {
        "type": "object",
        "properties": {
          "departure": {
            "type": "object",
            "properties": {
              "iataCode": { "type": "string", "example": "SIN" },
              "terminal": { "type": "string", "example": "3" },
              "at": { "type": "string", "example": "2026-10-15T01:30:00" }
            }
          },
          "arrival": {
            "type": "object",
            "properties": {
              "iataCode": { "type": "string", "example": "LHR" },
              "terminal": { "type": "string", "example": "2" },
              "at": { "type": "string", "example": "2026-10-15T15:00:00" }
            }
          },
          "carrierCode": { "type": "string", "example": "SQ" },
          "number": { "type": "string", "example": "317" },
          "aircraft": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "359" }
            }
          },
          "duration": { "type": "string", "example": "PT13H30M" },
          "id": { "type": "string", "example": "1" },
          "numberOfStops": { "type": "integer", "example": 0 },
          "blacklistedInEU": { "type": "boolean", "example": false }
        }
      },
      "FlightPrice": {
        "type": "object",
        "properties": {
          "currency": { "type": "string", "example": "USD" },
          "total": { "type": "string", "example": "1172.91" },
          "base": { "type": "string", "example": "1047.24" },
          "fees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "amount": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          },
          "grandTotal": { "type": "string", "example": "1172.91" }
        }
      },
      "TravelerPricing": {
        "type": "object",
        "properties": {
          "travelerId": { "type": "string", "example": "1" },
          "fareOption": { "type": "string", "example": "STANDARD" },
          "travelerType": {
            "type": "string",
            "enum": ["ADULT", "CHILD", "HELD_INFANT", "SEATED_INFANT", "SENIOR"],
            "example": "ADULT"
          },
          "price": {
            "type": "object",
            "properties": {
              "currency": { "type": "string" },
              "total": { "type": "string" },
              "base": { "type": "string" },
              "taxes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "amount": { "type": "string" },
                    "code": { "type": "string" }
                  }
                }
              }
            }
          },
          "fareDetailsBySegment": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "segmentId": { "type": "string" },
                "cabin": {
                  "type": "string",
                  "enum": ["ECONOMY", "PREMIUM_ECONOMY", "BUSINESS", "FIRST"]
                },
                "fareBasis": { "type": "string" },
                "brandedFare": { "type": "string" },
                "class": { "type": "string" },
                "includedCheckedBags": {
                  "type": "object",
                  "properties": {
                    "quantity": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "Traveler": {
        "type": "object",
        "required": ["id", "dateOfBirth", "name", "contact"],
        "properties": {
          "id": { "type": "string", "example": "1" },
          "dateOfBirth": { "type": "string", "format": "date", "example": "1990-04-14" },
          "name": {
            "type": "object",
            "properties": {
              "firstName": { "type": "string", "example": "JOHN" },
              "lastName": { "type": "string", "example": "DOE" }
            }
          },
          "gender": {
            "type": "string",
            "enum": ["MALE", "FEMALE", "UNSPECIFIED", "UNDISCLOSED"],
            "example": "MALE"
          },
          "contact": {
            "type": "object",
            "properties": {
              "emailAddress": { "type": "string", "example": "john.doe@example.com" },
              "phones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "deviceType": { "type": "string", "example": "MOBILE" },
                    "countryCallingCode": { "type": "string", "example": "65" },
                    "number": { "type": "string", "example": "91234567" }
                  }
                }
              }
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "documentType": { "type": "string", "example": "PASSPORT" },
                "number": { "type": "string", "example": "A12345678" },
                "expiryDate": { "type": "string", "format": "date", "example": "2030-01-01" },
                "issuanceCountry": { "type": "string", "example": "SG" },
                "nationality": { "type": "string", "example": "SG" },
                "holder": { "type": "boolean", "example": true }
              }
            }
          }
        }
      },
      "FlightOrderRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["type", "flightOffers", "travelers"],
            "properties": {
              "type": { "type": "string", "example": "flight-order" },
              "flightOffers": {
                "type": "array",
                "description": "One or more flight offers from /v2/shopping/flight-offers",
                "items": { "$ref": "#/components/schemas/FlightOffer" }
              },
              "travelers": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Traveler" }
              },
              "ticketingAgreement": {
                "type": "object",
                "properties": {
                  "option": {
                    "type": "string",
                    "enum": ["CONFIRM", "DELAY_TO_CANCEL", "DELAY_TO_QUEUE"],
                    "example": "DELAY_TO_CANCEL"
                  },
                  "delay": { "type": "string", "example": "6D" }
                }
              }
            }
          }
        }
      },
      "FlightOrderResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "flight-order" },
              "id": { "type": "string", "example": "MOCK3F9A1B2C" },
              "queuingOfficeId": { "type": "string", "example": "SINBA2222" },
              "associatedRecords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reference": { "type": "string", "example": "PNR4A2BCD" },
                    "creationDate": { "type": "string", "example": "2026-08-20T10:00:00.000" },
                    "originSystemCode": { "type": "string", "example": "GDS" },
                    "flightOfferId": { "type": "string", "example": "1" }
                  }
                }
              },
              "flightOffers": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/FlightOffer" }
              },
              "travelers": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Traveler" }
              }
            }
          }
        }
      },
      "HotelListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HotelListEntry"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "count": { "type": "integer", "example": 5 },
              "links": {
                "type": "object",
                "properties": {
                  "self": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "HotelListEntry": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "hotel" },
          "hotelId": { "type": "string", "example": "ADSINFL1" },
          "dupeId": { "type": "string", "example": "700178314" },
          "name": { "type": "string", "example": "THE FULLERTON HOTEL SINGAPORE" },
          "cityCode": { "type": "string", "example": "SIN" },
          "countryCode": { "type": "string", "example": "SG" },
          "iataCode": { "type": "string", "example": "SIN" },
          "address": {
            "type": "object",
            "properties": {
              "lines": {
                "type": "array",
                "items": { "type": "string" },
                "example": ["1 FULLERTON SQUARE"]
              },
              "postalCode": { "type": "string", "example": "049178" },
              "cityName": { "type": "string", "example": "SINGAPORE" },
              "countryCode": { "type": "string", "example": "SG" }
            }
          },
          "geoCode": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number", "example": 1.2864 },
              "longitude": { "type": "number", "example": 103.8534 }
            }
          },
          "distance": {
            "type": "object",
            "properties": {
              "value": { "type": "number", "example": 0.9 },
              "unit": { "type": "string", "example": "KM" }
            }
          },
          "amenities": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["SWIMMING_POOL", "SPA", "FITNESS_CENTER", "WIFI"]
          },
          "rating": { "type": "string", "example": "5" },
          "lastUpdate": { "type": "string", "example": "2025-01-01T00:00:00" }
        }
      },
      "HotelOffersResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HotelOffersEntry"
            }
          }
        }
      },
      "HotelOffersEntry": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "hotel-offers" },
          "hotel": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "hotel" },
              "hotelId": { "type": "string", "example": "ADSINFL1" },
              "name": { "type": "string", "example": "THE FULLERTON HOTEL SINGAPORE" },
              "cityCode": { "type": "string", "example": "SIN" },
              "countryCode": { "type": "string", "example": "SG" },
              "rating": { "type": "string", "example": "5" },
              "address": {
                "type": "object",
                "properties": {
                  "lines": { "type": "array", "items": { "type": "string" } },
                  "postalCode": { "type": "string" },
                  "cityName": { "type": "string" },
                  "countryCode": { "type": "string" }
                }
              },
              "amenities": { "type": "array", "items": { "type": "string" } },
              "geoCode": {
                "type": "object",
                "properties": {
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" }
                }
              }
            }
          },
          "available": { "type": "boolean", "example": true },
          "offers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HotelRoomOffer" }
          },
          "self": { "type": "string" }
        }
      },
      "HotelRoomOffer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "OFF3F9A1B2C4D5E" },
          "checkInDate": { "type": "string", "format": "date", "example": "2026-12-15" },
          "checkOutDate": { "type": "string", "format": "date", "example": "2026-12-18" },
          "rateCode": { "type": "string", "example": "RAC" },
          "category": { "type": "string", "example": "STANDARD" },
          "description": {
            "type": "object",
            "properties": {
              "lang": { "type": "string", "example": "EN" },
              "text": { "type": "string", "example": "Deluxe Room with heritage courtyard view" }
            }
          },
          "boardType": { "type": "string", "example": "ROOM_ONLY" },
          "room": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "DELUXE_ROOM" },
              "typeEstimated": {
                "type": "object",
                "properties": {
                  "category": { "type": "string", "example": "DELUXE_ROOM" },
                  "beds": { "type": "integer", "example": 1 },
                  "bedType": { "type": "string", "example": "KING" }
                }
              },
              "description": {
                "type": "object",
                "properties": {
                  "lang": { "type": "string" },
                  "text": { "type": "string" }
                }
              }
            }
          },
          "guests": {
            "type": "object",
            "properties": {
              "adults": { "type": "integer", "example": 2 }
            }
          },
          "price": {
            "type": "object",
            "properties": {
              "currency": { "type": "string", "example": "USD" },
              "base": { "type": "string", "example": "1260.00" },
              "total": { "type": "string", "example": "1373.40" },
              "taxes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "example": "GST" },
                    "amount": { "type": "string" },
                    "currency": { "type": "string" },
                    "percentage": { "type": "string", "example": "9.0" },
                    "included": { "type": "boolean", "example": false }
                  }
                }
              },
              "variations": {
                "type": "object",
                "properties": {
                  "average": {
                    "type": "object",
                    "properties": {
                      "base": { "type": "string" }
                    }
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "startDate": { "type": "string", "format": "date" },
                        "endDate": { "type": "string", "format": "date" },
                        "base": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "policies": {
            "type": "object",
            "properties": {
              "cancellations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "deadline": { "type": "string", "example": "2026-12-14T23:59:00" },
                    "description": {
                      "type": "object",
                      "properties": {
                        "lang": { "type": "string" },
                        "text": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "guarantee": {
                "type": "object",
                "properties": {
                  "acceptedPayments": {
                    "type": "object",
                    "properties": {
                      "creditCards": {
                        "type": "array",
                        "items": { "type": "string" },
                        "example": ["VI", "MC", "AX", "DC"]
                      },
                      "methods": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "paymentType": { "type": "string", "example": "GUARANTEE" }
            }
          },
          "self": { "type": "string" }
        }
      },
      "HotelOfferDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "hotel-offers" },
              "hotel": {
                "type": "object",
                "properties": {
                  "hotelId": { "type": "string" },
                  "name": { "type": "string" }
                }
              },
              "offers": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/HotelRoomOffer" }
              }
            }
          }
        }
      },
      "HotelOrderRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["hotelOffers", "guests", "payments"],
            "properties": {
              "hotelOffers": {
                "type": "array",
                "description": "Hotel offer IDs from /v3/shopping/hotel-offers",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "example": "OFF3F9A1B2C4D5E" }
                  }
                }
              },
              "guests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["tid", "firstName", "lastName", "phone", "email"],
                  "properties": {
                    "tid": { "type": "integer", "example": 1 },
                    "title": {
                      "type": "string",
                      "enum": ["MR", "MRS", "MS", "DR"],
                      "example": "MR"
                    },
                    "firstName": { "type": "string", "example": "JOHN" },
                    "lastName": { "type": "string", "example": "DOE" },
                    "phone": { "type": "string", "example": "+6591234567" },
                    "email": { "type": "string", "example": "john.doe@example.com" }
                  }
                }
              },
              "payments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "method": { "type": "string", "example": "creditCard" },
                    "card": {
                      "type": "object",
                      "properties": {
                        "vendorCode": { "type": "string", "example": "VI" },
                        "cardNumber": { "type": "string", "example": "4111111111111111" },
                        "expiryDate": { "type": "string", "example": "2028-01" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "HotelOrderResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "hotel-order" },
              "id": { "type": "string", "example": "HORDER3F9A1B2C" },
              "hotelBookings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "example": "hotel-booking" },
                    "id": { "type": "string", "example": "BKGABC12345" },
                    "bookingStatus": { "type": "string", "example": "CONFIRMED" },
                    "confRoomLists": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "confirmationId": { "type": "string", "example": "CONFABCDEF" }
                        }
                      }
                    }
                  }
                }
              },
              "associatedRecords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reference": { "type": "string", "example": "CONFABCDEF" },
                    "originSystemCode": { "type": "string", "example": "GDS" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
