# Workshop credentials - one-time setup:
#
#   cp env.example .env      (then edit .env with your values)
#
# .env is gitignored; never commit real credentials.
#
# Note: this is NOT SAM Desktop's <SAM_DIR>/.env (README Step 1.2) - that file
# configures SAM itself. This one feeds the workshop's service start commands.

# Foursquare Legacy API credentials (REQUIRED) - see README "API Keys Required"
FOURSQUARE_CLIENT_ID=YOUR_CLIENT_ID
FOURSQUARE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Anthropic API key (OPTIONAL) - enables AI activity recommendations in the
# Weather Advisor. Leave commented out to skip them.
# ANTHROPIC_API_KEY=sk-ant-...
